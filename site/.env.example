# Copy to site/.env. Everything here is public: it ends up in the built HTML.

PUBLIC_SITE_URL=https://unschool.cool

# Google Analytics 4. Leave empty to ship the site without any tracking script.
PUBLIC_GA4_ID=

# Firebase web config, used only by the /admin page sign-in.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=unschool-cool.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=unschool-cool
PUBLIC_USE_AUTH_EMULATOR=false
PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:5324

# Lets demo products be bought so the checkout can be tested locally.
# Must stay false for production builds.
PUBLIC_DEMO_CHECKOUT=false
