---
import { render } from 'astro:content';
import { LANGS, type Lang } from '~/i18n/config';
import { localePath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import { findLocalized, listSlugs, translatedLangs } from '~/lib/content';
import { formatDate } from '~/lib/format';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Icon from '~/components/Icon.astro';

export async function getStaticPaths() {
  const slugs = await listSlugs('pages');
  return LANGS.flatMap((lang) => slugs.map((page) => ({ params: { lang, page } })));
}

const lang = Astro.params.lang as Lang;
const slug = Astro.params.page as string;
const t = useTranslations(lang);

const localized = await findLocalized('pages', lang, slug);
if (!localized) throw new Error(`Missing page content: ${slug}`);

const { entry, isFallback, sourceLang } = localized;
const { Content } = await render(entry);
const translations = await translatedLangs('pages', slug);
const { data } = entry;

const isLegal = ['privacy', 'terms', 'accessibility'].includes(slug);
---

<BaseLayout
  lang={lang}
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.subtitle ?? data.title}
  translations={translations}
  fallbackFrom={isFallback ? sourceLang : null}
  narrow
>
  <Breadcrumbs
    lang={lang}
    items={[{ href: localePath(lang), label: t('nav.home') }, { label: data.title }]}
  />

  <header class="page-head">
    <h1>{data.title}</h1>
    {data.subtitle && <p class="lede">{data.subtitle}</p>}
    {data.updated && <p class="tiny muted">{formatDate(lang, data.updated)}</p>}
  </header>

  <div data-cta-sentinel></div>

  {
    data.contact && (
      <ul class="contact-list">
        {data.contact.email && (
          <li>
            <span class="contact-icon">
              <Icon name="mail" size={18} />
            </span>
            <span>
              <span class="contact-label">{t('contact.email')}</span>
              <a href={`mailto:${data.contact.email}`}>{data.contact.email}</a>
            </span>
          </li>
        )}
        {data.contact.phone && (
          <li>
            <span class="contact-icon">
              <Icon name="phone" size={18} />
            </span>
            <span>
              <span class="contact-label">{t('contact.phone')}</span>
              <a href={`tel:${data.contact.phone.replace(/\s/g, '')}`}>{data.contact.phone}</a>
            </span>
          </li>
        )}
        {data.contact.hours && (
          <li>
            <span class="contact-icon">
              <Icon name="info" size={18} />
            </span>
            <span>
              <span class="contact-label">{t('contact.hours')}</span>
              {data.contact.hours}
            </span>
          </li>
        )}
      </ul>
    )
  }

  {
    data.formats.length > 0 && (
      <section class="section section--tight" aria-labelledby="formats-title">
        <h2 id="formats-title" class="visually-hidden">
          {t('formats.title')}
        </h2>
        <ul class="format-list">
          {data.formats.map((format, index) => (
            <li data-reveal>
              <span class="format-index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{format.name}</h3>
                <p>{format.details}</p>
              </div>
              <span class="format-price">{format.price}</span>
            </li>
          ))}
        </ul>
        <p class="tiny muted confirmed">
          <Icon name="check" size={14} />
          {t('formats.confirmed')}
        </p>
      </section>
    )
  }

  <section class="section section--tight prose">
    <Content />
  </section>

  {
    !isLegal && (
      <section class="section section--tight">
        <a class="btn btn--primary" href={localePath(lang, 'diagnostic')} data-track="cta_page">
          {t('cta.bookFree')}
          <Icon name="arrow" size={18} class="flip-rtl" />
        </a>
        <p class="cta-note">{t('cta.bookNote')}</p>
      </section>
    )
  }
</BaseLayout>

<style>
  .page-head {
    max-width: 34rem;
    margin-bottom: var(--s6);
  }

  .page-head h1 {
    margin-bottom: var(--s3);
  }

  .contact-list {
    list-style: none;
    margin: 0 0 var(--s6);
    padding: 0;
    display: grid;
    gap: var(--s3);
  }

  .contact-list li {
    display: flex;
    gap: var(--s3);
    align-items: center;
    margin: 0;
    padding: var(--s4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }

  .contact-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--brand-deep);
  }

  .contact-label {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .format-list {
    list-style: none;
    margin: 0 0 var(--s4);
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  .format-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s3) var(--s4);
    margin: 0;
    padding: var(--s5) 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .format-index {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--brand);
    padding-top: 0.3rem;
  }

  .format-list h3 {
    margin-bottom: var(--s2);
  }

  .format-list p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .format-price {
    grid-column: 2;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--grape);
  }

  .confirmed {
    display: flex;
    align-items: center;
    gap: var(--s2);
  }

  .confirmed :global(.icon) {
    color: var(--ok);
  }

  @media (min-width: 40rem) {
    .format-list li {
      grid-template-columns: auto 1fr auto;
      align-items: center;
    }

    .format-price {
      grid-column: auto;
      text-align: end;
    }
  }
</style>
