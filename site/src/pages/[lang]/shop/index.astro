---
import { LANG_NAME, langParams, LANGS, type Lang } from '~/i18n/config';
import { localePath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import {
  PRODUCT_TYPES,
  STAGES,
  SUBJECTS,
  productTypeKey,
  stageNameKey,
  subjectNameKey,
} from '~/data/taxonomy';
import { listByLang, sortByOrder } from '~/lib/content';
import { absolute } from '~/lib/schema';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import ProductCard from '~/components/ProductCard.astro';
import Callout from '~/components/Callout.astro';
import Icon from '~/components/Icon.astro';

export function getStaticPaths() {
  return langParams();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const products = sortByOrder(await listByLang('products', lang));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t('shop.title'),
  numberOfItems: products.length,
  itemListElement: products.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: product.data.title,
    url: absolute(localePath(lang, `shop/${product.data.slug}`), Astro.site),
  })),
};
---

<BaseLayout
  lang={lang}
  title={t('shop.seoTitle')}
  description={t('shop.seoDescription')}
  pageType="CollectionPage"
  jsonLd={jsonLd}
  stickyCta={false}
  bleed
>
  <PageHeader
    lang={lang}
    title={t('shop.title')}
    subtitle={t('shop.intro')}
    eyebrow={t('nav.materials')}
    crumbs={[{ href: localePath(lang), label: t('nav.home') }, { label: t('shop.title') }]}
    accent="var(--brand)"
    soft="var(--paper-2)"
    glyph="₪"
  />

  <div class="wrap page">
    <details class="filters-box" open data-filters-box>
      <summary class="filters-toggle">
        <Icon name="chevron" size={16} />
        {t('shop.filter.title')}
      </summary>
      <form class="filters" id="shop-filters" aria-label={t('shop.title')}>
        <label class="filter">
          <span class="filter-label">{t('shop.filter.subject')}</span>
          <select name="subject">
            <option value="">{t('shop.filter.all')}</option>
            {
              SUBJECTS.map((subject) => (
                <option value={subject}>{t(subjectNameKey(subject))}</option>
              ))
            }
          </select>
        </label>

        <label class="filter">
          <span class="filter-label">{t('shop.filter.stage')}</span>
          <select name="stage">
            <option value="">{t('shop.filter.all')}</option>
            {STAGES.map((stage) => <option value={stage}>{t(stageNameKey(stage))}</option>)}
          </select>
        </label>

        <label class="filter">
          <span class="filter-label">{t('shop.filter.type')}</span>
          <select name="type">
            <option value="">{t('shop.filter.all')}</option>
            {PRODUCT_TYPES.map((type) => <option value={type}>{t(productTypeKey(type))}</option>)}
          </select>
        </label>

        <label class="filter">
          <span class="filter-label">{t('shop.filter.language')}</span>
          <select name="language">
            <option value="">{t('shop.filter.all')}</option>
            {LANGS.map((code) => <option value={code}>{LANG_NAME[code]}</option>)}
          </select>
        </label>
      </form>
    </details>

    <div class="results">
      <p class="small muted" id="shop-results" aria-live="polite">
        {t('shop.results', { count: products.length })}
      </p>
      <button class="reset" type="reset" form="shop-filters" data-reset hidden>
        <Icon name="close" size={14} />
        {t('shop.filter.reset')}
      </button>
    </div>

    <div class="grid grid--3" id="shop-grid">
      {
        products.map((product) => (
          <div data-reveal>
            <ProductCard lang={lang} product={product} />
          </div>
        ))
      }
    </div>

    <p class="muted empty" id="shop-empty" hidden>{t('shop.empty')}</p>

    <div class="section">
      <Callout
        title={t('home.unsure.title')}
        text={t('product.relatedDiagnostic')}
        href={localePath(lang, 'diagnostic')}
        linkLabel={t('cta.bookFree')}
      />
    </div>
  </div>
</BaseLayout>

<script define:vars={{ resultsTemplate: t('shop.results', { count: '__count__' }) }}>
  const form = document.getElementById('shop-filters');
  const grid = document.getElementById('shop-grid');
  const results = document.getElementById('shop-results');
  const empty = document.getElementById('shop-empty');

  const box = document.querySelector('[data-filters-box]');
  if (box instanceof HTMLDetailsElement && !window.matchMedia('(min-width: 48rem)').matches) {
    box.open = false;
  }

  if (form instanceof HTMLFormElement && grid && results && empty) {
    const cards = Array.from(grid.querySelectorAll('[data-product-card]'));

    const apply = () => {
      const data = new FormData(form);
      const subject = String(data.get('subject') ?? '');
      const stage = String(data.get('stage') ?? '');
      const type = String(data.get('type') ?? '');
      const language = String(data.get('language') ?? '');

      let visible = 0;
      cards.forEach((card) => {
        const stages = (card.dataset.stages ?? '').split(' ').filter(Boolean);
        const matches =
          (!subject || card.dataset.subject === subject) &&
          (!stage || stages.includes(stage)) &&
          (!type || card.dataset.type === type) &&
          (!language || card.dataset.language === language);

        const holder = card.parentElement;
        if (holder) holder.hidden = !matches;
        if (matches) visible += 1;
      });

      results.textContent = resultsTemplate.replace('__count__', String(visible));
      empty.hidden = visible > 0;
      const reset = document.querySelector('[data-reset]');
      if (reset) reset.hidden = !(subject || stage || type || language);
    };

    form.addEventListener('change', apply);
    form.addEventListener('reset', () => window.requestAnimationFrame(apply));
  }
</script>

<style>
  /* A closed select cannot wrap, so a column is never narrower than the longest
     option plus the select's padding and arrow. */
  .filters-box {
    margin-bottom: var(--s4);
    background: var(--paper-2);
    border-radius: var(--r-md);
  }

  .filters-toggle {
    display: flex;
    align-items: center;
    gap: var(--s2);
    min-height: 3rem;
    padding: 0 var(--s4);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .filters-toggle::-webkit-details-marker {
    display: none;
  }

  .filters-toggle :global(svg) {
    transform: rotate(90deg);
    transition: transform 0.2s var(--ease);
  }

  .filters-box[open] .filters-toggle :global(svg) {
    transform: rotate(-90deg);
  }

  @media (min-width: 48rem) {
    .filters-toggle {
      display: none;
    }
  }

  .filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    align-items: end;
    gap: var(--s3);
    padding: 0 var(--s4) var(--s4);
  }

  @media (min-width: 48rem) {
    .filters {
      padding-top: var(--s4);
    }
  }

  .filter-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: var(--s2);
  }

  .filters select {
    min-height: 2.75rem;
    font-size: 1rem;
  }

  .results {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2) var(--s4);
    min-height: 2.75rem;
    margin-bottom: var(--s4);
  }

  .results p {
    margin: 0;
  }

  .reset {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    min-height: 2.75rem;
    padding: 0 var(--s3);
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--brand-deep);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
  }

  .reset:hover {
    background: var(--brand-soft);
  }

  .reset[hidden] {
    display: none;
  }

  .empty {
    margin-top: var(--s5);
  }
</style>
