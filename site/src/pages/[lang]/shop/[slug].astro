---
import { render } from 'astro:content';
import { LANG_NAME, LANGS, type Lang } from '~/i18n/config';
import { localePath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import { SUBJECT_THEME, productTypeKey, subjectNameKey } from '~/data/taxonomy';
import { findLocalized, listByLang, listSlugs, sortByOrder, translatedLangs } from '~/lib/content';
import { formatPrice } from '~/lib/format';
import { digitalProduct, rasterCover } from '~/lib/schema';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import SectionHead from '~/components/SectionHead.astro';
import InfoCard from '~/components/InfoCard.astro';
import ProductCard from '~/components/ProductCard.astro';
import Icon from '~/components/Icon.astro';
import Callout from '~/components/Callout.astro';

export async function getStaticPaths() {
  const slugs = await listSlugs('products');
  return LANGS.flatMap((lang) => slugs.map((slug) => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const t = useTranslations(lang);

const localized = await findLocalized('products', lang, slug);
if (!localized) throw new Error(`Missing product content: ${slug}`);

const { entry, isFallback, sourceLang } = localized;
const { Content } = await render(entry);
const translations = await translatedLangs('products', slug);
const { data } = entry;
const theme = SUBJECT_THEME[data.subject];

const isFree = data.price === 0;
const companion = data.sample ?? data.full;
const companionEntry = companion ? await findLocalized('products', lang, companion) : null;

const related = sortByOrder(
  (await listByLang('products', lang)).filter(
    (item) => item.data.slug !== slug && item.data.subject === data.subject
  )
).slice(0, 3);

const jsonLd = digitalProduct(
  {
    title: data.title,
    summary: data.summary,
    cover: rasterCover(data.cover),
    price: data.price,
    currency: data.currency,
    subject: t(subjectNameKey(data.subject)),
    grades: data.grades,
    fileFormat: data.fileFormat,
    materialLanguage: data.materialLanguage,
  },
  new URL(Astro.url.pathname, Astro.site ?? 'https://unschool.cool'),
  Astro.site
);

const terms = [
  { icon: 'download' as const, label: t('product.access'), text: data.accessNote },
  { icon: 'file' as const, label: t('product.compatibility'), text: data.compatibilityNote },
  { icon: 'info' as const, label: t('product.usage'), text: data.usageNote },
  { icon: 'star' as const, label: t('product.refund'), text: data.refundNote },
];
---

<BaseLayout
  lang={lang}
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.summary}
  translations={translations}
  fallbackFrom={isFallback ? sourceLang : null}
  stickyCta={false}
  image={rasterCover(data.cover)}
  imageAlt={data.title}
  ogType="product"
  pageType="ItemPage"
  jsonLd={jsonLd}
  viewEvent="view_product"
  viewId={slug}
  bleed
>
  <PageHeader
    lang={lang}
    title={data.title}
    subtitle={data.summary}
    eyebrow={t(productTypeKey(data.type))}
    crumbs={[{ href: localePath(lang, 'shop'), label: t('shop.title') }, { label: data.title }]}
    accent={theme.accent}
    soft={theme.soft}
  >
    <ul class="chip-row meta-chips">
      <li><span class="chip chip--outline">{t(subjectNameKey(data.subject))}</span></li>
      <li><span class="chip chip--outline">{data.grades}</span></li>
      <li><span class="chip chip--outline">{LANG_NAME[data.materialLanguage]}</span></li>
      {
        isFree && (
          <li>
            <span class="chip chip--accent">{t('common.free')}</span>
          </li>
        )
      }
    </ul>
  </PageHeader>

  <div class="wrap page product-layout" style={`--accent:${theme.accent};--soft:${theme.soft}`}>
    <div class="product-head">
      <img class="cover" src={data.cover} alt="" width="960" height="640" />
    </div>

    <aside class="product-aside">
      <div class="buy-box">
        <p class:list={['buy-price', { 'buy-price--free': isFree }]}>
          {isFree ? t('common.free') : formatPrice(lang, data.price)}
          {data.listPrice && <s class="buy-list-price">{formatPrice(lang, data.listPrice)}</s>}
        </p>
        <a
          class="btn btn--primary btn--block"
          href={`${localePath(lang, 'checkout')}?product=${data.slug}`}
          data-track="checkout_start"
        >
          {isFree ? t('product.getFree') : t('product.buy')}
          <Icon name="arrow" size={18} class="flip-rtl" />
        </a>
        <ul class="buy-facts">
          <li>
            <Icon name="file" size={16} />
            <span>{data.fileFormat}</span>
          </li>
          <li>
            <Icon name="download" size={16} />
            <span>{data.accessNote}</span>
          </li>
        </ul>
        {
          companionEntry && (
            <a
              class="arrow-link buy-companion"
              href={localePath(lang, `shop/${companionEntry.entry.data.slug}`)}
            >
              {data.sample ? t('product.trySample') : t('product.getFull')}
              <Icon name="arrow" size={16} class="flip-rtl" />
            </a>
          )
        }
      </div>
    </aside>

    <div class="product-body">
      {
        data.previews.length > 0 && (
          <section class="section section--tight" aria-labelledby="preview-title">
            <SectionHead title={t('product.preview')} id="preview-title" />
            <ul class="previews">
              {data.previews.map((preview, index) => (
                <li>
                  <button
                    class="preview-open"
                    type="button"
                    data-preview={preview}
                    aria-label={t('product.previewOpen').replace('{n}', String(index + 1))}
                  >
                    <img src={preview} alt="" width="400" height="560" loading="lazy" />
                  </button>
                </li>
              ))}
            </ul>
            <dialog class="preview-dialog" data-preview-dialog>
              <button class="preview-close" type="button" data-preview-close>
                <Icon name="close" size={20} />
                <span class="visually-hidden">{t('product.previewClose')}</span>
              </button>
              <img src={data.previews[0]} alt="" width="794" height="1123" />
            </dialog>
          </section>
        )
      }

      <section class="section section--tight prose">
        <Content />
      </section>

      <section class="section section--tight" aria-labelledby="details-title">
        <SectionHead title={t('product.whatYouGet')} id="details-title" />
        <div class="details">
          {
            data.contents.length > 0 && (
              <div class="details-contents">
                <InfoCard
                  icon="file"
                  label={t('product.contents')}
                  items={data.contents}
                  accent={theme.accent}
                />
              </div>
            )
          }
          <InfoCard
            icon="download"
            label={t('product.fileFormat')}
            text={data.fileFormat}
            accent={theme.accent}
          />
          {
            data.level && (
              <InfoCard
                icon="star"
                label={t('product.level')}
                text={data.level}
                accent={theme.accent}
              />
            )
          }
          {
            data.outcome && (
              <InfoCard
                icon="check"
                label={t('product.outcome')}
                text={data.outcome}
                accent={theme.accent}
              />
            )
          }
        </div>
      </section>

      {
        data.modules.length > 0 && (
          <section class="section section--tight" aria-labelledby="modules-title">
            <SectionHead title={t('product.modules')} id="modules-title" />
            <ol class="modules">
              {data.modules.map((module, index) => (
                <li>
                  <span class="module-index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="module-title">{module.title}</span>
                  {module.duration && <span class="module-time">{module.duration}</span>}
                </li>
              ))}
            </ol>
            {data.totalDuration && (
              <p class="tiny muted">
                {t('product.duration')}: {data.totalDuration}
              </p>
            )}
          </section>
        )
      }

      <section class="section section--tight" aria-labelledby="terms-title">
        <SectionHead title={t('product.access')} id="terms-title" />
        <dl class="terms">
          {
            terms.map((term) => (
              <div>
                <dt>
                  <Icon name={term.icon} size={16} />
                  {term.label}
                </dt>
                <dd>{term.text}</dd>
              </div>
            ))
          }
          <div>
            <dt><Icon name="mail" size={16} />{t('product.support')}</dt>
            <dd><a href={`mailto:${data.supportContact}`}>{data.supportContact}</a></dd>
          </div>
        </dl>
      </section>
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="related-title">
        <div class="wrap">
          <SectionHead title={t('product.related')} id="related-title" />
          <div class="grid grid--3">
            {related.map((item) => (
              <ProductCard lang={lang} product={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--tight help">
    <div class="wrap">
      <Callout
        title={t('home.unsure.title')}
        text={t('product.relatedDiagnostic')}
        href={localePath(lang, 'diagnostic')}
        linkLabel={t('cta.bookFree')}
      />
    </div>
  </section>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-preview-dialog]');
  const image = dialog?.querySelector('img');
  document.querySelectorAll<HTMLButtonElement>('[data-preview]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog || !image) return;
      image.src = button.dataset.preview ?? '';
      dialog.showModal();
    });
  });
  dialog?.querySelector('[data-preview-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .cover {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    margin-bottom: var(--s6);
  }

  .meta-chips {
    margin-top: var(--s4);
  }

  /* The buy box sits right under the summary on mobile and becomes a sticky
     column on desktop. */
  .product-aside {
    margin-bottom: var(--s6);
  }

  .previews {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(9rem, 40%), 1fr));
    gap: var(--s3);
  }

  .previews li {
    margin: 0;
  }

  .preview-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    overflow: hidden;
    cursor: zoom-in;
    transition:
      transform 0.18s var(--ease),
      box-shadow 0.18s var(--ease);
  }

  .preview-open:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .preview-open img {
    display: block;
    width: 100%;
    height: auto;
  }

  .preview-dialog {
    max-width: min(48rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    overflow: auto;
  }

  .preview-dialog::backdrop {
    background: rgba(23, 20, 42, 0.6);
  }

  .preview-dialog img {
    display: block;
    width: 100%;
    height: auto;
  }

  .preview-close {
    position: sticky;
    top: var(--s3);
    float: inline-end;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: var(--s3);
    margin-bottom: -3.5rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .details {
    display: grid;
    gap: var(--s4);
  }

  .details > * {
    min-width: 0;
  }

  .details-contents :global(ul) {
    column-gap: var(--s6);
  }

  @media (min-width: 40rem) {
    .details {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }

    .details-contents {
      grid-column: 1 / -1;
    }

    .details-contents :global(ul) {
      columns: 2;
    }

    .details-contents :global(li) {
      break-inside: avoid;
    }
  }

  .help {
    padding-top: 0;
  }

  .modules {
    list-style: none;
    margin: 0 0 var(--s3);
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .modules li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s3);
    margin: 0;
    padding: var(--s4) 0;
    border-bottom: 1px solid var(--line);
  }

  .module-index {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent);
  }

  .module-title {
    flex: 1;
    font-weight: 500;
  }

  .module-time {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .terms {
    margin: 0;
    display: grid;
    gap: var(--s4);
  }

  .terms div {
    padding-top: var(--s3);
    border-top: 1px solid var(--line);
  }

  .terms dt {
    display: flex;
    align-items: center;
    gap: var(--s2);
    margin-bottom: var(--s2);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .terms dd {
    margin: 0;
    font-size: 0.9375rem;
  }

  .buy-box {
    padding: var(--s5);
    background: var(--surface);
    border: 1.5px solid var(--line-strong);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-sm);
  }

  .buy-price {
    display: flex;
    align-items: baseline;
    gap: var(--s3);
    margin: 0 0 var(--s4);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .buy-price--free {
    font-size: 1.5rem;
    overflow-wrap: anywhere;
  }

  .buy-list-price {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .buy-companion {
    margin-top: var(--s4);
  }

  .buy-facts {
    display: grid;
    gap: var(--s2);
    margin: var(--s4) 0 0;
    padding: var(--s4) 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .buy-facts li {
    display: flex;
    align-items: flex-start;
    gap: var(--s2);
    margin: 0;
  }

  .buy-facts :global(svg) {
    flex: none;
    margin-top: 0.2em;
    color: var(--brand);
  }

  @media (min-width: 64rem) {
    .product-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 20rem;
      grid-template-areas: 'head aside' 'body aside';
      column-gap: var(--s8);
      align-items: start;
    }

    .product-head {
      grid-area: head;
    }

    .product-body {
      grid-area: body;
    }

    .product-aside {
      grid-area: aside;
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      margin-bottom: 0;
    }
  }
</style>
