---
import { langParams, type Lang } from '~/i18n/config';
import { localePath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import { listByLang, sortByOrder } from '~/lib/content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import TeacherCard from '~/components/TeacherCard.astro';

export function getStaticPaths() {
  return langParams();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const teachers = sortByOrder(await listByLang('teachers', lang));
---

<BaseLayout
  lang={lang}
  title={t('teachers.seoTitle')}
  description={t('teachers.seoDescription')}
  pageType="CollectionPage"
  bleed
>
  <PageHeader
    lang={lang}
    title={t('teachers.title')}
    subtitle={t('teachers.intro')}
    eyebrow={t('nav.teachers')}
    crumbs={[{ href: localePath(lang), label: t('nav.home') }, { label: t('teachers.title') }]}
    soft="var(--paper-2)"
  />

  <div data-cta-sentinel></div>

  <div class="wrap page">
    {
      teachers.length > 0 ? (
        <div class="grid grid--2">
          {teachers.map((teacher) => (
            <div data-reveal>
              <TeacherCard lang={lang} teacher={teacher} />
            </div>
          ))}
        </div>
      ) : (
        <p class="muted">{t('teachers.empty')}</p>
      )
    }
  </div>
</BaseLayout>
