---
import { langParams, type Lang } from '~/i18n/config';
import { localePath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import { listByLang } from '~/lib/content';

export function getStaticPaths() {
  return langParams();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const titles = Object.fromEntries(
  (await listByLang('products', lang)).map(({ data }) => [data.slug, data.title])
);
---

<BaseLayout
  lang={lang}
  title={t('order.success.title')}
  description={t('order.success.text')}
  noindex
  stickyCta={false}
  footerCta={false}
>
  <section class="order" id="order-view" data-lang={lang}>
    <h1 class="visually-hidden">{t('order.success.title')}</h1>
    <div id="order-paid" hidden>
      <span class="status-icon status-icon--ok"><Icon name="check" size={28} /></span>
      <h2 class="state-title" data-paid-title></h2>
      <p class="lede" data-paid-text></p>

      <dl class="order-meta">
        <div>
          <dt>{t('checkout.order')}</dt>
          <dd data-order-title></dd>
        </div>
        <div>
          <dt>{t('checkout.total')}</dt>
          <dd data-order-total></dd>
        </div>
        <div>
          <dt>{t('checkout.email')}</dt>
          <dd data-order-email></dd>
        </div>
      </dl>

      <div class="order-actions">
        <a class="btn btn--primary btn--block" id="order-download" href="#" hidden>
          <Icon name="download" size={18} />
          {t('order.download')}
        </a>
        <button class="btn btn--outline btn--block" type="button" id="order-resend">
          <Icon name="mail" size={18} />
          {t('order.resend')}
        </button>
        <p class="form-status form-status--ok" id="order-resent" hidden>{t('order.resent')}</p>
        <p class="small muted">{t('order.linkNote')}</p>
      </div>
    </div>

    <!-- Shown first: the seconds right after paying are the anxious ones. -->
    <div id="order-pending">
      <span class="status-icon status-icon--wait"><Icon name="wallet" size={26} /></span>
      <h2 class="state-title">{t('order.pending.title')}</h2>
      <p class="lede" data-pending-text>{t('order.pending.text')}</p>
    </div>

    <div id="order-missing" hidden>
      <span class="status-icon status-icon--warn"><Icon name="info" size={26} /></span>
      <h2 class="state-title">{t('order.notFound')}</h2>
      <p class="lede">
        {t('order.support')}: <a href="mailto:hello@unschool.cool">hello@unschool.cool</a>
      </p>
      <div class="order-actions order-actions--row">
        <a class="btn btn--primary" href={localePath(lang, 'shop')}>
          {t('cta.toCatalog')}
          <Icon name="arrow" size={18} class="flip-rtl" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script
  define:vars={{
    lang,
    titles,
    messages: {
      paidTitle: t('order.success.title'),
      paidText: t('order.success.text'),
      freeTitle: t('order.free.title'),
      freeText: t('order.free.text'),
      slow: t('order.pending.slow'),
      free: t('common.free'),
    },
  }}
>
  const views = {
    paid: document.getElementById('order-paid'),
    pending: document.getElementById('order-pending'),
    missing: document.getElementById('order-missing'),
  };

  // URL shape is /{lang}/order/{token}/success/, rewritten to this page by hosting.
  const match = window.location.pathname.match(/\/order\/([^/]+)\/success/);
  const token = match?.[1] ?? '';

  const money = (amount) =>
    new Intl.NumberFormat(`${lang}-IL`, {
      style: 'currency',
      currency: 'ILS',
      maximumFractionDigits: Number.isInteger(amount) ? 0 : 2,
    }).format(amount);

  const show = (name) => {
    Object.entries(views).forEach(([key, node]) => {
      if (node) node.hidden = key !== name;
    });
  };

  let attempts = 0;

  async function poll() {
    if (!token) {
      show('missing');
      return;
    }

    try {
      const response = await fetch(`/api/shop/orders/${encodeURIComponent(token)}`, {
        cache: 'no-store',
      });
      if (response.status === 404) {
        show('missing');
        return;
      }
      const order = await response.json();
      if (!response.ok) throw new Error(order.error);

      if (order.status === 'paid') {
        const free = order.amount === 0;
        document.querySelector('[data-paid-title]').textContent = free
          ? messages.freeTitle
          : messages.paidTitle;
        document.querySelector('[data-paid-text]').textContent = free
          ? messages.freeText
          : messages.paidText;
        document.querySelector('[data-order-title]').textContent =
          titles[order.productId] ?? order.productName;
        document.querySelector('[data-order-total]').textContent = free
          ? messages.free
          : money(order.amount / 100);
        document.querySelector('[data-order-email]').textContent = order.emailHint;

        const download = document.getElementById('order-download');
        if (download && order.downloadUrl) {
          download.href = order.downloadUrl;
          download.hidden = false;
        }

        show('paid');
        if (!free) {
          window.track?.('purchase_confirmed', {
            item_id: order.productId,
            value: order.amount / 100,
            currency: order.currency,
          });
        }
        return;
      }

      show('pending');
      attempts += 1;
      if (attempts < 40) {
        window.setTimeout(poll, 3000);
      } else {
        document.querySelector('[data-pending-text]').textContent = messages.slow;
      }
    } catch {
      attempts += 1;
      if (attempts < 40) window.setTimeout(poll, 3000);
      else show('missing');
    }
  }

  const resend = document.getElementById('order-resend');
  resend?.addEventListener('click', async () => {
    if (!token) return;
    resend.disabled = true;
    try {
      const response = await fetch(`/api/shop/orders/${encodeURIComponent(token)}/resend`, {
        method: 'POST',
      });
      const result = await response.json();
      const notice = document.getElementById('order-resent');
      if (notice && result.ok) notice.hidden = false;
    } finally {
      resend.disabled = false;
    }
  });

  poll();
</script>

<style>
  .order {
    padding-block: clamp(3rem, 9vw, 6rem);
    max-width: 36rem;
  }

  .order [hidden] {
    display: none;
  }

  .state-title {
    font-size: clamp(1.85rem, 6vw, 3rem);
    margin-bottom: var(--s3);
  }

  .status-icon {
    display: inline-grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin-bottom: var(--s5);
    border-radius: 50%;
    background: var(--ok-soft);
    color: var(--ok);
  }

  .status-icon--wait {
    background: var(--brand-soft);
    color: var(--brand-deep);
  }

  .status-icon--warn {
    background: var(--accent-soft);
    color: var(--honey);
  }

  .order-meta {
    margin: var(--s6) 0;
    padding: var(--s5);
    display: grid;
    gap: var(--s4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }

  .order-meta dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .order-meta dd {
    margin: 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .order-actions {
    display: grid;
    gap: var(--s3);
    margin-top: var(--s6);
  }

  .order-actions--row {
    display: flex;
    flex-wrap: wrap;
  }

  .order-actions p {
    margin: 0;
  }
</style>
