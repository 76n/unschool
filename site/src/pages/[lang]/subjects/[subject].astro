---
import { render } from 'astro:content';
import { LANGS, type Lang } from '~/i18n/config';
import { localePath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import {
  STAGES,
  SUBJECTS,
  SUBJECT_GLYPH,
  SUBJECT_THEME,
  stageGradesKey,
  stageNameKey,
  subjectNameKey,
  type Subject,
} from '~/data/taxonomy';
import { findLocalized, listByLang, sortByOrder, translatedLangs } from '~/lib/content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import SectionHead from '~/components/SectionHead.astro';
import ProgramCard from '~/components/ProgramCard.astro';
import TeacherCard from '~/components/TeacherCard.astro';
import Icon from '~/components/Icon.astro';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => SUBJECTS.map((subject) => ({ params: { lang, subject } })));
}

const lang = Astro.params.lang as Lang;
const subject = Astro.params.subject as Subject;
const t = useTranslations(lang);

const localized = await findLocalized('subjects', lang, subject);
if (!localized) throw new Error(`Missing subject content: ${subject}`);

const { entry, isFallback, sourceLang } = localized;
const { Content } = await render(entry);
const translations = await translatedLangs('subjects', subject);
const theme = SUBJECT_THEME[subject];

const programs = sortByOrder(
  (await listByLang('programs', lang)).filter((program) => program.data.subjects.includes(subject))
);
const teachers = sortByOrder(
  (await listByLang('teachers', lang)).filter((teacher) => teacher.data.subjects.includes(subject))
);
---

<BaseLayout
  lang={lang}
  title={entry.data.seoTitle ?? entry.data.title}
  description={entry.data.seoDescription ?? entry.data.subtitle}
  translations={translations}
  fallbackFrom={isFallback ? sourceLang : null}
  pageType="CollectionPage"
  viewEvent="view_subject"
  viewId={subject}
  bleed
>
  <PageHeader
    lang={lang}
    title={entry.data.title}
    subtitle={entry.data.subtitle}
    eyebrow={t('subject.plural')}
    crumbs={[{ href: localePath(lang), label: t('nav.home') }, { label: entry.data.title }]}
    accent={theme.accent}
    soft={theme.soft}
    glyph={SUBJECT_GLYPH[subject]}
    cta
    ctaTrack="cta_subject"
  />

  <div data-cta-sentinel></div>

  <div class="wrap page">
    {
      entry.data.goals.length > 0 && (
        <section class="section section--tight">
          <SectionHead title={t('subject.page.goals')} id="goals-title" />
          <ul class="goals">
            {entry.data.goals.map((goal) => (
              <li data-reveal style={`--accent:${theme.accent}`}>
                <Icon name="check" size={18} />
                <span>{goal}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="section section--tight prose">
      <Content />
    </section>

    <section class="section" aria-labelledby="programs-title">
      <SectionHead
        eyebrow={t('nav.programs')}
        title={t('subject.page.programs')}
        id="programs-title"
      />
      {
        programs.length > 0 ? (
          <div class="grid grid--2">
            {programs.map((program) => (
              <div data-reveal>
                <ProgramCard lang={lang} program={program} showSubjects={false} />
              </div>
            ))}
          </div>
        ) : (
          <p class="muted">{t('programs.empty')}</p>
        )
      }
    </section>

    <section class="section" aria-labelledby="stages-title">
      <SectionHead title={t('subject.page.stages')} id="stages-title" />
      <ul class="stage-links">
        {
          STAGES.map((stage) => (
            <li>
              <a href={localePath(lang, `stages/${stage}`)}>
                <span class="stage-grades">{t(stageGradesKey(stage))}</span>
                <span class="stage-name">{t(stageNameKey(stage))}</span>
                <Icon name="arrow" size={18} class="flip-rtl" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      teachers.length > 0 && (
        <section class="section" aria-labelledby="teachers-title">
          <SectionHead title={t('subject.page.teachers')} id="teachers-title" />
          <div class="grid grid--2">
            {teachers.map((teacher) => (
              <TeacherCard lang={lang} teacher={teacher} />
            ))}
          </div>
        </section>
      )
    }

    <section class="section section--tight">
      <p class="eyebrow">{t('subject.plural')}</p>
      <ul class="chip-row">
        {
          SUBJECTS.filter((item) => item !== subject).map((item) => (
            <li>
              <a class="chip" href={localePath(lang, `subjects/${item}`)}>
                {t(subjectNameKey(item))}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .goals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s3);
  }

  .goals li {
    display: flex;
    gap: var(--s3);
    align-items: flex-start;
    margin: 0;
    padding: var(--s3) var(--s4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }

  .goals :global(.icon) {
    color: var(--accent);
    margin-top: 3px;
  }

  .stage-links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  .stage-links li {
    margin: 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .stage-links a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s4);
    padding: var(--s4) var(--s2);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }

  .stage-links a:hover {
    background: var(--paper-2);
  }

  .stage-grades {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--brand);
    min-width: 5.5ch;
  }

  .stage-name {
    font-weight: 600;
  }

  .stage-links :global(.icon) {
    color: var(--ink-soft);
  }

  @media (min-width: 48rem) {
    .goals {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
