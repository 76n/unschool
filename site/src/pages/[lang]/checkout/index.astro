---
import { langParams, type Lang } from '~/i18n/config';
import { localePath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { countryOptions } from '~/data/countries';
import { listByLang } from '~/lib/content';

export function getStaticPaths() {
  return langParams();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const countries = countryOptions(lang);
const products = (await listByLang('products', lang)).map(({ data }) => ({
  slug: data.slug,
  title: data.title,
  price: data.price,
  listPrice: data.listPrice ?? null,
}));
---

<BaseLayout
  lang={lang}
  title={t('checkout.title')}
  description={t('checkout.guest')}
  noindex
  stickyCta={false}
  narrow
>
  <h1 data-title>{t('checkout.title')}</h1>

  <p class="form-status form-status--error" id="checkout-error" hidden role="alert"></p>

  <section class="summary" id="order-summary" hidden aria-labelledby="summary-title">
    <h2 id="summary-title" class="summary-heading">{t('checkout.order')}</h2>
    <p class="summary-product" data-summary-title></p>
    <div class="summary-row" data-row="list" hidden>
      <span>{t('checkout.listPrice')}</span>
      <s data-summary-list></s>
    </div>
    <div class="summary-row" data-row="price">
      <span>{t('checkout.price')}</span>
      <span data-summary-price></span>
    </div>
    <div class="summary-row summary-row--discount" data-row="coupon" hidden>
      <span data-summary-coupon></span>
      <span data-summary-discount></span>
    </div>
    <div class="summary-total">
      <span>{t('checkout.total')}</span>
      <span data-summary-total></span>
    </div>
  </section>

  <form class="checkout-form" id="checkout-form" novalidate hidden data-lang={lang}>
    <div class="name-row" data-paid-only>
      <label class="field" data-field="firstName">
        <span class="field-label">{t('checkout.firstName')}</span>
        <input type="text" name="firstName" autocomplete="given-name" maxlength="60" />
        <span class="field-error" data-error="firstName" hidden></span>
      </label>
      <label class="field" data-field="lastName">
        <span class="field-label">{t('checkout.lastName')}</span>
        <input type="text" name="lastName" autocomplete="family-name" maxlength="60" />
        <span class="field-error" data-error="lastName" hidden></span>
      </label>
    </div>

    <label class="field" data-free-only hidden>
      <span class="field-label">
        {t('checkout.name')}
        <span class="field-hint">{t('common.optional')}</span>
      </span>
      <input type="text" name="name" autocomplete="given-name" maxlength="60" />
    </label>

    <label class="field" data-field="phone" data-paid-only>
      <span class="field-label">{t('checkout.phone')}</span>
      <input type="tel" name="phone" inputmode="tel" autocomplete="tel" dir="ltr" />
      <span class="field-error" data-error="phone" hidden></span>
    </label>

    <label class="field" data-field="country" data-paid-only>
      <span class="field-label">{t('checkout.country')}</span>
      <select name="country" autocomplete="country">
        {countries.map((country) => <option value={country.value}>{country.label}</option>)}
      </select>
    </label>

    <label class="field" data-field="email">
      <span class="field-label">
        {t('checkout.email')}
        <span class="field-hint" data-paid-only>{t('checkout.emailHint')}</span>
        <span class="field-hint" data-free-only hidden>{t('checkout.emailFreeHint')}</span>
      </span>
      <input type="email" name="email" inputmode="email" autocomplete="email" dir="ltr" required />
      <span class="field-error" data-error="email" hidden></span>
    </label>

    <div class="field" data-field="coupon">
      <label class="field-label" for="checkout-coupon">
        {t('checkout.coupon')}
        <span class="field-hint">{t('common.optional')}</span>
      </label>
      <div class="coupon-row">
        <input
          id="checkout-coupon"
          class="code-input"
          type="text"
          name="coupon"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          maxlength="40"
          dir="ltr"
        />
        <button class="btn btn--outline" type="button" data-coupon-apply>
          {t('checkout.couponApply')}
        </button>
      </div>
      <span class="field-ok" data-coupon-ok hidden></span>
      <span class="field-error" data-error="coupon" hidden></span>
    </div>

    <fieldset class="methods" data-field="method" hidden>
      <legend class="field-label">{t('checkout.method')}</legend>
      <label class="method" data-method="card">
        <input type="radio" name="method" value="card" />
        <span>{t('checkout.method.card')}</span>
      </label>
      <label class="method" data-method="bit">
        <input type="radio" name="method" value="bit" />
        <span>{t('checkout.method.bit')}</span>
      </label>
    </fieldset>

    <div class="terms" data-field="marketing">
      <label class="terms-check">
        <input type="checkbox" name="marketing" />
        <span>
          {t('checkout.marketing')}{' '}
          <a href={localePath(lang, 'privacy')} target="_blank">{t('footer.privacy')}</a>
        </span>
      </label>
      <span class="field-error" data-error="marketing" hidden></span>
    </div>

    <div class="terms" data-field="acceptTerms" data-paid-only>
      <label class="terms-check">
        <input type="checkbox" name="acceptTerms" />
        <span>
          {t('checkout.acceptTerms')}{' '}
          <a href={localePath(lang, 'terms')} target="_blank">{t('footer.terms')}</a>
        </span>
      </label>
      <span class="field-error" data-error="acceptTerms" hidden></span>
    </div>

    <div class="honeypot" aria-hidden="true">
      <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
    </div>

    <button class="btn btn--primary btn--block" type="submit" data-submit
      >{t('checkout.pay')}</button
    >
    <p class="cta-note">{t('checkout.guest')}</p>
  </form>

  <p class="muted" id="checkout-missing" hidden>
    {t('checkout.missingProduct')}
    <a href={localePath(lang, 'shop')}>{t('cta.toCatalog')}</a>
  </p>
</BaseLayout>

<script
  define:vars={{
    lang,
    catalog: products,
    messages: {
      email: t('checkout.error.email'),
      required: t('checkout.error.required'),
      phone: t('checkout.error.phone'),
      terms: t('checkout.error.terms'),
      marketing: t('checkout.error.marketing'),
      server: t('checkout.error.server'),
      unavailable: t('checkout.error.unavailable'),
      payUnavailable: t('checkout.error.payUnavailable'),
      rateLimited: t('checkout.error.rateLimited'),
      sending: t('common.sending'),
      free: t('common.free'),
      title: t('checkout.title'),
      titleFree: t('checkout.titleFree'),
      pay: t('checkout.pay'),
      getFile: t('checkout.getFile'),
      couponLine: t('checkout.couponLine'),
      couponApplied: t('checkout.couponApplied'),
      couponSaved: t('checkout.couponSaved'),
      coupon: {
        couponNotFound: t('coupon.error.couponNotFound'),
        couponNotStarted: t('coupon.error.couponNotStarted'),
        couponExpired: t('coupon.error.couponExpired'),
        couponExhausted: t('coupon.error.couponExhausted'),
        couponNotApplicable: t('coupon.error.couponNotApplicable'),
      },
    },
  }}
>
  const form = document.getElementById('checkout-form');
  const summary = document.getElementById('order-summary');
  const missing = document.getElementById('checkout-missing');
  const errorBox = document.getElementById('checkout-error');

  const params = new URLSearchParams(window.location.search);
  const product = catalog.find((item) => item.slug === params.get('product'));

  const fill = (text, values) => text.replace(/\{(\w+)\}/g, (match, name) => values[name] ?? match);
  const money = (amount) =>
    new Intl.NumberFormat(`${lang}-IL`, {
      style: 'currency',
      currency: 'ILS',
      maximumFractionDigits: Number.isInteger(amount) ? 0 : 2,
    }).format(amount);
  const minor = (amount) => amount / 100;
  const select = (selector) => summary.querySelector(selector);
  const fieldError = (name) => form.querySelector(`[data-error="${name}"]`);

  const showError = (name, message) => {
    form.querySelector(`[data-field="${name}"]`)?.setAttribute('data-invalid', 'true');
    const error = fieldError(name);
    if (error) {
      error.textContent = message;
      error.hidden = false;
    }
  };

  const clearError = (name) => {
    form.querySelector(`[data-field="${name}"]`)?.removeAttribute('data-invalid');
    const error = fieldError(name);
    if (error) error.hidden = true;
  };

  const showBanner = (message) => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = !message;
  };

  const errorMessage = (key) => {
    if (!key) return messages.server;
    if (key.startsWith('errors.coupon')) return messages.coupon[key.slice(7)] ?? messages.server;
    if (key === 'shop.unavailable' || key === 'shop.orderNotFound' || key === 'unavailable')
      return messages.unavailable;
    if (key === 'pay.unavailable') return messages.payUnavailable;
    if (key === 'shop.marketingRequired') return messages.marketing;
    if (key === 'shop.termsRequired') return messages.terms;
    if (key === 'rate_limited') return messages.rateLimited;
    return messages.server;
  };

  let quote = null;
  let isFree = false;

  function setMode(free) {
    isFree = free;
    document.querySelector('[data-title]').textContent = free ? messages.titleFree : messages.title;
    form.querySelectorAll('[data-paid-only]').forEach((node) => {
      node.hidden = free;
    });
    form.querySelectorAll('[data-free-only]').forEach((node) => {
      node.hidden = !free;
    });
    const submit = form.querySelector('[data-submit]');
    if (submit) submit.textContent = free ? messages.getFile : messages.pay;
  }

  function renderSummary({ listPrice, unitPrice, discount, amount, code }) {
    select('[data-summary-title]').textContent = product.title;
    select('[data-row="list"]').hidden = !listPrice;
    if (listPrice) select('[data-summary-list]').textContent = money(listPrice);
    select('[data-summary-price]').textContent = unitPrice ? money(unitPrice) : messages.free;
    select('[data-row="coupon"]').hidden = !discount;
    if (discount) {
      select('[data-summary-coupon]').textContent = fill(messages.couponLine, { code });
      select('[data-summary-discount]').textContent = `−${money(discount)}`;
    }
    select('[data-summary-total]').textContent = amount ? money(amount) : messages.free;
  }

  function renderMethods(methods) {
    const box = form.querySelector('[data-field="method"]');
    form.querySelectorAll('[data-method]').forEach((label) => {
      const offered = methods.includes(label.dataset.method);
      label.hidden = !offered;
      const input = label.querySelector('input');
      if (!offered) input.checked = false;
    });
    box.hidden = isFree || methods.length < 2;
    const offered = [...form.querySelectorAll('input[name="method"]')].filter(
      (input) => !input.closest('label').hidden
    );
    if (offered.length > 0 && !offered.some((input) => input.checked)) offered[0].checked = true;
  }

  const couponInput = form?.querySelector('input[name="coupon"]');
  const couponOk = form?.querySelector('[data-coupon-ok]');
  const couponValue = () => couponInput.value.trim().toUpperCase();

  async function requestQuote() {
    const code = couponValue();
    const response = await fetch('/api/shop/quote', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ productId: product.slug, coupon: code || null }),
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(result.error || 'shop.failed');
    return result;
  }

  async function applyQuote({ showCoupon }) {
    clearError('coupon');
    if (couponOk) couponOk.hidden = true;
    try {
      quote = await requestQuote();
    } catch (error) {
      quote = null;
      showBanner(errorMessage(error.message));
      return;
    }
    showBanner('');
    setMode(quote.amount === 0 && quote.unitPrice === 0);
    const couponFailed = Boolean(quote.coupon?.error);
    renderSummary({
      listPrice: quote.listPrice ? minor(quote.listPrice) : null,
      unitPrice: minor(quote.unitPrice),
      discount: couponFailed ? 0 : minor(quote.discount),
      amount: minor(quote.amount),
      code: quote.coupon?.code ?? '',
    });
    renderMethods(quote.methods);
    const marketing = form.querySelector('[data-field="marketing"] input');
    if (marketing) marketing.required = quote.marketingRequired;
    if (!showCoupon || !quote.coupon) return;
    if (couponFailed) {
      showError('coupon', messages.coupon[quote.coupon.error] ?? messages.server);
    } else if (couponOk) {
      couponOk.textContent = fill(isFree ? messages.couponSaved : messages.couponApplied, {
        code: quote.coupon.code,
      });
      couponOk.hidden = false;
    }
  }

  function init() {
    if (!product || !(form instanceof HTMLFormElement) || !summary) {
      if (missing) missing.hidden = false;
      return;
    }

    const initialCoupon = params.get('coupon');
    if (initialCoupon) couponInput.value = initialCoupon.toUpperCase().slice(0, 40);

    setMode(product.price === 0);
    renderSummary({
      listPrice: product.listPrice,
      unitPrice: product.price,
      discount: 0,
      amount: product.price,
      code: '',
    });
    summary.hidden = false;
    form.hidden = false;
    window.track?.('checkout_start', { item_id: product.slug });
    applyQuote({ showCoupon: Boolean(initialCoupon) });

    couponInput.addEventListener('input', () => {
      const start = couponInput.selectionStart;
      couponInput.value = couponInput.value.toUpperCase();
      couponInput.setSelectionRange(start, start);
    });
    couponInput.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      applyQuote({ showCoupon: true });
    });
    form
      .querySelector('[data-coupon-apply]')
      ?.addEventListener('click', () => applyQuote({ showCoupon: true }));

    const submit = form.querySelector('[data-submit]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const value = (name) => String(data.get(name) ?? '').trim();
      const marketing = data.get('marketing') === 'on';
      const acceptTerms = data.get('acceptTerms') === 'on';
      const email = value('email');
      const buyer = isFree
        ? { firstName: value('name'), lastName: '', phone: '', country: '', email }
        : {
            firstName: value('firstName'),
            lastName: value('lastName'),
            phone: value('phone'),
            country: value('country'),
            email,
          };

      ['firstName', 'lastName', 'phone', 'email', 'marketing', 'acceptTerms'].forEach(clearError);
      showBanner('');

      const problems = [];
      if (!isFree) {
        if (!buyer.firstName) problems.push(['firstName', messages.required]);
        if (!buyer.lastName) problems.push(['lastName', messages.required]);
        if (!/^[+]?[\d\s()-]{7,20}$/.test(buyer.phone)) problems.push(['phone', messages.phone]);
        if (!acceptTerms) problems.push(['acceptTerms', messages.terms]);
      }
      if (!/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(email)) problems.push(['email', messages.email]);
      if ((quote?.marketingRequired ?? isFree) && !marketing)
        problems.push(['marketing', messages.marketing]);

      if (problems.length) {
        problems.forEach(([name, message]) => showError(name, message));
        form
          .querySelector('[data-invalid]')
          ?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }

      if (submit instanceof HTMLButtonElement) {
        submit.disabled = true;
        submit.textContent = messages.sending;
      }

      let utm = {};
      try {
        utm = JSON.parse(sessionStorage.getItem('unschool:utm') || '{}');
      } catch {
        utm = {};
      }

      try {
        const response = await fetch('/api/shop/orders', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            productId: product.slug,
            coupon: couponValue() || null,
            locale: lang,
            buyer,
            method: isFree ? null : data.get('method') || null,
            acceptTerms,
            marketing,
            utm,
            returnUrl: `${window.location.origin}/${lang}/order/{token}/success/`,
            company: value('company'),
          }),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.ok) {
          const key = result.error;
          if (typeof key === 'string' && key.startsWith('errors.coupon')) {
            showError('coupon', errorMessage(key));
          } else if (key === 'shop.marketingRequired') {
            showError('marketing', messages.marketing);
          } else {
            showBanner(errorMessage(key));
          }
          window.track?.('checkout_error', { item_id: product.slug, error: key });
          return;
        }

        if (result.status === 'paid') {
          window.track?.('free_download', { item_id: product.slug });
          window.location.assign(`/${lang}/order/${result.token}/success/`);
          return;
        }
        window.location.assign(result.url);
      } catch {
        showBanner(messages.server);
      } finally {
        if (submit instanceof HTMLButtonElement) {
          submit.disabled = false;
          submit.textContent = isFree ? messages.getFile : messages.pay;
        }
      }
    });
  }

  init();
</script>

<style>
  /* A short form should not stretch across a desktop page. */
  .summary,
  .checkout-form,
  #checkout-error,
  #checkout-missing {
    max-width: 34rem;
  }

  .name-row {
    display: grid;
    column-gap: var(--s4);
  }

  @media (min-width: 30rem) {
    .name-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .name-row[hidden],
  .field[hidden],
  .terms[hidden],
  .methods[hidden],
  .method[hidden] {
    display: none;
  }

  .coupon-row {
    display: flex;
    gap: var(--s2);
  }

  .coupon-row input {
    flex: 1;
    min-width: 0;
  }

  .methods {
    margin: 0 0 var(--s5);
    padding: 0;
    border: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }

  .methods legend {
    margin-bottom: var(--s2);
  }

  .method {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    padding: var(--s2) var(--s4);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    cursor: pointer;
  }

  .method input {
    accent-color: var(--grape);
  }

  .terms {
    margin-bottom: var(--s5);
  }

  .terms-check {
    display: flex;
    align-items: flex-start;
    gap: var(--s3);
    font-size: 0.875rem;
    line-height: 1.5;
    cursor: pointer;
  }

  .terms-check input {
    flex: none;
    inline-size: 1.125rem;
    block-size: 1.125rem;
    margin-block-start: 0.15rem;
    accent-color: var(--grape);
  }

  .terms[data-invalid] .terms-check span {
    color: var(--danger);
  }

  .summary {
    margin-block: var(--s6) var(--s5);
    padding: var(--s5);
    background: var(--paper-2);
    border-radius: var(--r-md);
  }

  .summary-heading {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: var(--s3);
  }

  .summary-product {
    margin: 0 0 var(--s3);
    font-weight: 600;
  }

  .summary-row,
  .summary-total {
    display: flex;
    justify-content: space-between;
    gap: var(--s3);
  }

  .summary-row[hidden] {
    display: none;
  }

  .summary-row s {
    color: var(--ink-soft);
  }

  .summary-row--discount {
    color: var(--ok);
  }

  .summary-total {
    margin-top: var(--s3);
    padding-top: var(--s3);
    border-top: 1px solid var(--line-strong);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
  }
</style>
