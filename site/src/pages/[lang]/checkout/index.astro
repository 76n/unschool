---
import { langParams, type Lang } from '~/i18n/config';
import { localePath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { countryOptions } from '~/data/countries';

export function getStaticPaths() {
  return langParams();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const countries = countryOptions(lang);
---

<BaseLayout
  lang={lang}
  title={t('checkout.title')}
  description={t('checkout.guest')}
  noindex
  stickyCta={false}
  narrow
>
  <h1>{t('checkout.title')}</h1>

  <p class="form-status form-status--error" id="checkout-error" hidden role="alert"></p>

  <section class="summary" id="order-summary" hidden aria-labelledby="summary-title">
    <h2 id="summary-title" class="summary-heading">{t('checkout.order')}</h2>
    <div class="summary-row">
      <span data-summary-title></span>
      <span data-summary-price></span>
    </div>
    <p class="summary-note muted small" data-summary-demo hidden>{t('shop.demoNotice')}</p>
    <div class="summary-total">
      <span>{t('checkout.total')}</span>
      <span data-summary-total></span>
    </div>
  </section>

  <form class="checkout-form" id="checkout-form" novalidate hidden data-lang={lang}>
    <div class="name-row">
      <label class="field" data-field="firstName">
        <span class="field-label">{t('checkout.firstName')}</span>
        <input type="text" name="firstName" autocomplete="given-name" maxlength="60" required />
        <span class="field-error" data-error="firstName" hidden></span>
      </label>
      <label class="field" data-field="lastName">
        <span class="field-label">{t('checkout.lastName')}</span>
        <input type="text" name="lastName" autocomplete="family-name" maxlength="60" required />
        <span class="field-error" data-error="lastName" hidden></span>
      </label>
    </div>

    <label class="field" data-field="phone">
      <span class="field-label">{t('checkout.phone')}</span>
      <input type="tel" name="phone" inputmode="tel" autocomplete="tel" dir="ltr" required />
      <span class="field-error" data-error="phone" hidden></span>
    </label>

    <label class="field" data-field="country">
      <span class="field-label">{t('checkout.country')}</span>
      <select name="country" autocomplete="country" required>
        {countries.map((country) => <option value={country.value}>{country.label}</option>)}
      </select>
    </label>

    <label class="field" data-field="email">
      <span class="field-label">
        {t('checkout.email')}
        <span class="field-hint">{t('checkout.emailHint')}</span>
      </span>
      <input type="email" name="email" inputmode="email" autocomplete="email" dir="ltr" required />
      <span class="field-error" data-error="email" hidden></span>
    </label>

    <div class="terms" data-field="acceptTerms">
      <label class="terms-check">
        <input type="checkbox" name="acceptTerms" required />
        <span>
          {t('checkout.acceptTerms')}{' '}
          <a href={localePath(lang, 'terms')} target="_blank">{t('footer.terms')}</a>
        </span>
      </label>
      <span class="field-error" data-error="acceptTerms" hidden></span>
    </div>

    <div class="honeypot" aria-hidden="true">
      <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
    </div>

    <button class="btn btn--primary btn--block" type="submit" data-submit
      >{t('checkout.pay')}</button
    >
    <p class="cta-note">{t('checkout.guest')}</p>
  </form>

  <p class="muted" id="checkout-missing" hidden>
    {t('checkout.missingProduct')}
    <a href={localePath(lang, 'shop')}>{t('cta.toCatalog')}</a>
  </p>
</BaseLayout>

<script
  define:vars={{
    lang,
    messages: {
      email: t('checkout.error.email'),
      required: t('checkout.error.required'),
      phone: t('checkout.error.phone'),
      terms: t('checkout.error.terms'),
      server: t('checkout.error.server'),
      notForSale: t('product.notForSale'),
      sending: t('common.sending'),
    },
    shopUrl: localePath(lang, 'shop'),
  }}
>
  const form = document.getElementById('checkout-form');
  const summary = document.getElementById('order-summary');
  const missing = document.getElementById('checkout-missing');
  const errorBox = document.getElementById('checkout-error');

  const slug = new URLSearchParams(window.location.search).get('product');

  const showMissing = () => {
    if (missing) missing.hidden = false;
  };

  const money = (amount) =>
    new Intl.NumberFormat(`${lang}-IL`, {
      style: 'currency',
      currency: 'ILS',
      maximumFractionDigits: 0,
    }).format(amount);

  async function init() {
    if (!slug || !(form instanceof HTMLFormElement) || !summary) {
      showMissing();
      return;
    }

    let product;
    try {
      const catalog = await fetch('/catalog.json').then((response) => response.json());
      product =
        catalog.find((item) => item.slug === slug && item.lang === lang) ??
        catalog.find((item) => item.slug === slug);
    } catch {
      showMissing();
      return;
    }

    if (!product) {
      showMissing();
      return;
    }

    summary.querySelector('[data-summary-title]').textContent = product.title;
    summary.querySelector('[data-summary-price]').textContent = money(product.price);
    summary.querySelector('[data-summary-total]').textContent = money(product.price);
    if (product.status === 'demo') {
      summary.querySelector('[data-summary-demo]').hidden = false;
    }

    summary.hidden = false;
    form.hidden = false;
    window.track?.('checkout_start', { item_id: product.slug });

    const submit = form.querySelector('[data-submit]');
    const submitLabel = submit?.textContent ?? '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = Object.fromEntries(new FormData(form).entries());
      const value = (name) => String(data[name] ?? '').trim();
      const payload = {
        firstName: value('firstName'),
        lastName: value('lastName'),
        phone: value('phone'),
        country: value('country'),
        email: value('email'),
        acceptTerms: data.acceptTerms === 'on',
      };

      form
        .querySelectorAll('[data-field]')
        .forEach((field) => field.removeAttribute('data-invalid'));
      form.querySelectorAll('[data-error]').forEach((error) => {
        error.hidden = true;
      });
      if (errorBox) errorBox.hidden = true;

      const problems = [];
      if (!payload.firstName) problems.push(['firstName', messages.required]);
      if (!payload.lastName) problems.push(['lastName', messages.required]);
      if (!/^[+]?[\d\s()-]{7,20}$/.test(payload.phone)) problems.push(['phone', messages.phone]);
      if (!/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(payload.email))
        problems.push(['email', messages.email]);
      if (!payload.acceptTerms) problems.push(['acceptTerms', messages.terms]);

      if (problems.length) {
        for (const [name, message] of problems) {
          form.querySelector(`[data-field="${name}"]`)?.setAttribute('data-invalid', 'true');
          const error = form.querySelector(`[data-error="${name}"]`);
          if (error) {
            error.textContent = message;
            error.hidden = false;
          }
        }
        return;
      }

      if (submit instanceof HTMLButtonElement) {
        submit.disabled = true;
        submit.textContent = messages.sending;
      }

      try {
        const response = await fetch('/api/orders', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            slug: product.slug,
            lang,
            ...payload,
            company: data.company,
          }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          if (errorBox) {
            errorBox.textContent =
              result.error === 'not_for_sale' ? messages.notForSale : messages.server;
            errorBox.hidden = false;
          }
          window.track?.('checkout_error', { item_id: product.slug });
          return;
        }

        window.location.assign(result.redirectUrl);
      } catch {
        if (errorBox) {
          errorBox.textContent = messages.server;
          errorBox.hidden = false;
        }
      } finally {
        if (submit instanceof HTMLButtonElement) {
          submit.disabled = false;
          submit.textContent = submitLabel;
        }
      }
    });
  }

  init();
</script>

<style>
  /* A short form should not stretch across a desktop page. */
  .summary,
  .checkout-form,
  #checkout-error,
  #checkout-missing {
    max-width: 34rem;
  }

  .name-row {
    display: grid;
    column-gap: var(--s4);
  }

  @media (min-width: 30rem) {
    .name-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .terms {
    margin-bottom: var(--s5);
  }

  .terms-check {
    display: flex;
    align-items: flex-start;
    gap: var(--s3);
    font-size: 0.875rem;
    line-height: 1.5;
    cursor: pointer;
  }

  .terms-check input {
    flex: none;
    inline-size: 1.125rem;
    block-size: 1.125rem;
    margin-block-start: 0.15rem;
    accent-color: var(--grape);
  }

  .terms[data-invalid] .terms-check span {
    color: var(--danger);
  }

  .summary {
    margin-block: var(--s6) var(--s5);
    padding: var(--s5);
    background: var(--paper-2);
    border-radius: var(--r-md);
  }

  .summary-heading {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: var(--s3);
  }

  .summary-row,
  .summary-total {
    display: flex;
    justify-content: space-between;
    gap: var(--s3);
  }

  .summary-note {
    margin: var(--s2) 0 0;
  }

  .summary-total {
    margin-top: var(--s3);
    padding-top: var(--s3);
    border-top: 1px solid var(--line-strong);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
  }
</style>
