---
/**
 * Trilingual ticker. Says what the school is in all three alphabets at once,
 * which no amount of body copy can do as quickly.
 */
interface Props {
  items: string[];
  tone?: 'dark' | 'accent';
}

const { items, tone = 'dark' } = Astro.props;
const loop = [...items, ...items];
---

<div class={`marquee marquee--${tone}`} role="presentation" aria-hidden="true">
  <div class="marquee-track">
    {
      loop.map((item) => (
        <span class="marquee-item">
          {item}
          <span class="marquee-dot" />
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: var(--s4);
    border-block: 1.5px solid;
    user-select: none;
  }

  .marquee--dark {
    background: var(--grape);
    color: var(--paper);
    border-color: var(--grape);
  }

  .marquee--accent {
    background: var(--accent);
    color: var(--ink);
    border-color: var(--ink);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 42s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 1.75rem;
    padding-inline-end: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 4.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .marquee-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .marquee--accent .marquee-dot {
    background: var(--grape);
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* In RTL the track is laid out from the right, so it has to travel the
     opposite way to stay on screen. */
  @keyframes marquee-scroll-rtl {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(50%);
    }
  }

  :global(:root[dir='rtl']) .marquee-track {
    animation-name: marquee-scroll-rtl;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      width: 100%;
      overflow: hidden;
    }
  }
</style>
