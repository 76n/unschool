---
import Doodle from './Doodle.astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  text: string;
  href?: string;
  linkLabel?: string;
}

const { title, text, href, linkLabel } = Astro.props;
---

<aside class="callout">
  <div class="callout-inner">
    <div>
      <Doodle variant="sparkle" color="var(--grape)" />
      <p class="callout-title">{title}</p>
      <p class="callout-text">{text}</p>
    </div>
    {
      href && linkLabel && (
        <a class="arrow-link callout-link" href={href}>
          {linkLabel}
          <Icon name="arrow" size={16} class="flip-rtl" />
        </a>
      )
    }
  </div>
</aside>

<style>
  .callout {
    container-type: inline-size;
    padding: var(--s5);
    background: var(--accent);
    border-radius: var(--r-md);
    color: var(--ink);
  }

  .callout :global(.doodle) {
    margin-bottom: var(--s3);
    opacity: 0.75;
  }

  .callout-title {
    margin: 0 0 var(--s2);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .callout-text {
    margin: 0;
    font-size: 0.9375rem;
    max-width: 34ch;
  }

  .callout-link {
    margin-top: var(--s3);
    color: var(--grape);
    align-items: flex-start;
  }

  .callout-link :global(.icon) {
    margin-top: 0.2em;
  }

  .callout-link:hover {
    color: var(--ink);
  }

  @container (min-width: 44rem) {
    .callout-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s6);
    }

    .callout-text {
      max-width: 52ch;
    }

    .callout-link {
      flex: none;
      margin-top: 0;
    }
  }
</style>
