---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  icon: IconName;
  label: string;
  text?: string;
  items?: string[];
  accent?: string;
}

const { icon, label, text, items = [], accent = 'var(--brand)' } = Astro.props;
---

<div class="info-card" style={`--accent:${accent}`}>
  <span class="info-icon"><Icon name={icon} size={20} /></span>
  <div class="info-body">
    <p class="info-label">{label}</p>
    {text && <p class="info-text">{text}</p>}
    {
      items.length > 0 && (
        <ul class="info-list">
          {items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
    <slot />
  </div>
</div>

<style>
  .info-card {
    display: flex;
    gap: var(--s4);
    height: 100%;
    padding: var(--s5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    transition:
      border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .info-card:hover {
    border-color: var(--line-strong);
  }

  .info-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
  }

  .info-body {
    min-width: 0;
  }

  .info-label {
    margin: 0 0 var(--s1);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .info-text {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .info-list {
    margin: 0;
    padding-inline-start: 1.05rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
</style>
