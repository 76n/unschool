# Copy to functions/.env and fill in before deploying. Never commit real values.

# Diagnostic requests go to Telegram. The bot token and chat ID are Secret Manager
# secrets rather than env values:
#   firebase functions:secrets:set TELEGRAM_BOT_TOKEN --project unschool-cool
#   firebase functions:secrets:set TELEGRAM_CHAT_ID --project unschool-cool

SUPPORT_EMAIL=hello@unschool.cool
MAIL_FROM=Unschool <hello@unschool.cool>

# "mock" until Grow credentials exist, then "grow"
PAYMENT_PROVIDER=mock
GROW_USER_ID=
GROW_PAGE_CODE=
GROW_API_KEY=
GROW_SANDBOX=true

# Demo products stay unbuyable unless this is on (emulator only)
ALLOW_DEMO_ORDERS=false

# Comma separated Google accounts allowed into /admin/
ADMIN_EMAILS=

# How long a download link stays valid (minutes)
DOWNLOAD_TTL_MINUTES=4320
